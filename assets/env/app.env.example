# Copy to assets/env/app.env and fill in. app.env is gitignored; this template is not.
#
# Both files are bundled as Flutter assets, so anything here is extractable from the APK/IPA.
# Only values that are safe to publish belong in this file.
#
# Everything else lives in the Supabase `app_config` table: public rows are readable by the
# app, private rows only by the Edge Functions. The Fast2SMS credentials are private rows
# there, so they never reach a device.
#
# Leaving all of it blank is safe: the app falls back to its in-memory repositories and
# onboarding accepts any 6-digit code.

# --- Supabase -------------------------------------------------------------
# The anon key is public by design; RLS is what protects the data behind it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Fast2SMS (legacy, optional) -------------------------------------------
# Only for the fallback that calls Fast2SMS straight from the app, which ships the key inside
# the binary. Prefer Supabase above, and leave these blank when it is configured.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# --- app_config fallbacks --------------------------------------------------
# One line per PUBLIC `app_config` row, named APP_CONFIG_ + the key in upper case. They answer
# only when Supabase never has: the ladder is
#
#     Supabase fetch  ->  disk cache (stale included)  ->  these  ->  defaultAppConfig in Dart
#
# so a value changed in the dashboard is never shadowed by one set here, and a device that has
# never reached Supabase still runs on real values instead of the compiled constants.
#
# Three rules:
#   1. BLANK MEANS "NOT SET HERE", not "blank this key" — an empty line falls through to the Dart
#      default rather than overwriting it. To deliberately blank a value, do it in the dashboard.
#   2. PUBLIC ROWS ONLY. This file is bundled as a Flutter asset and is extractable from the
#      APK/IPA, so a private row pasted here is as exposed as one marked public in the table.
#      `cashfree_secret_key`, `fast2sms_*`, `reconcile_secret` and `review_otp` stay server-side;
#      anything secret-shaped is refused at load and logged. `mixpanel_token` is the one
#      sanctioned exception, exactly as it is in `app_config_secrets_stay_private`.
#   3. Adding a public row to a migration wants a line here too, or its offline fallback is
#      whatever `defaultAppConfig` happens to hold.
#
# The values below are the ones the migrations seed, so this template matches production.

APP_CONFIG_ENV=production
APP_CONFIG_API_BASE_URL=https://symwrytqyhyxlcjaubru.supabase.co
APP_CONFIG_MIN_SUPPORTED_VERSION=1.0.0

APP_CONFIG_OTP_LENGTH=6
APP_CONFIG_OTP_EXPIRY_MINUTES=5
APP_CONFIG_OTP_RESEND_COOLDOWN_SECONDS=30

APP_CONFIG_MAX_TRACKED_PEOPLE=3
APP_CONFIG_INVITE_URL_BASE=https://loc360.app/invite

# Paywall copy and the numbers the ad networks bid against. Never used to compute a charge —
# what is actually taken comes from the Cashfree plan and from private rows.
APP_CONFIG_CASHFREE_TRIAL_DAYS=2
APP_CONFIG_TRIAL_PRICE_LABEL=₹3
APP_CONFIG_PLAN_PRICE_LABEL=₹499
APP_CONFIG_TRIAL_PRICE_AMOUNT=3
APP_CONFIG_PLAN_PRICE_AMOUNT=499
APP_CONFIG_CURRENCY_CODE=INR

# The Facebook app conversions are reported to, and the switch that silences reporting. The
# native SDKs initialise from the manifest/plist, not from here.
APP_CONFIG_FACEBOOK_APP_ID=2559504461180471
APP_CONFIG_FACEBOOK_EVENTS_ENABLED=true

# Write-only and public by design, so it may live here. Blank leaves the app on NoopAnalytics —
# which is the right state for a checkout not pointed at a Mixpanel project.
APP_CONFIG_MIXPANEL_TOKEN=

# https or nothing: iOS ATS and Android both refuse cleartext, so an http:// URL fails on every
# device. Blank means no promo card, which is the correct state when there is nothing to show.
APP_CONFIG_PAYWALL_VIDEO_URL=

# --- Edge Function rows, mirrored ------------------------------------------
# Present so this file mirrors the table, but INERT: nothing in Dart reads any of them. They are
# read server-side by `supabase/functions/_shared/config.ts` via service_role, which never comes
# through this file. Left blank here on purpose — copy the values from the dashboard only if you
# want the mirror to be complete, and never add a row the app cannot already read.
APP_CONFIG_ALLOW_DEV_OTP=
APP_CONFIG_CASHFREE_API_VERSION=
APP_CONFIG_CASHFREE_PLAN_ID=
APP_CONFIG_CASHFREE_TRIAL_AMOUNT=
APP_CONFIG_CASHFREE_RECURRING_AMOUNT=
APP_CONFIG_ENTITLEMENT_GRACE_HOURS=
