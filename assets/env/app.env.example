# Copy to assets/env/app.env and fill in. app.env is gitignored; this template is not.
#
# Both files are bundled as Flutter assets, so anything here is extractable from the APK/IPA.
# Only values that are safe to publish belong in this file.
#
# Everything else lives in the Supabase `app_config` table: public rows are readable by the
# app, private rows only by the Edge Functions. The Fast2SMS credentials are private rows
# there, so they never reach a device.
#
# Leaving all of it blank is safe: the app falls back to its in-memory repositories and
# onboarding accepts any 6-digit code.

# --- Supabase -------------------------------------------------------------
# The anon key is public by design; RLS is what protects the data behind it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Fast2SMS (legacy, optional) -------------------------------------------
# Only for the fallback that calls Fast2SMS straight from the app, which ships the key inside
# the binary. Prefer Supabase above, and leave these blank when it is configured.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
