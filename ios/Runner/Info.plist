<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Circle 360</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>loc_360</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Circle 360 uses your location to show tracking status and send location updates while you have the app open.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Circle 360 needs "Always" access.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Circle 360 needs "Always" access.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Invite deeplink, e.g. loc360://invite?code=ABC123&amp;from=Mom -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.spacewire.circle360.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>loc360</string>
			</array>
		</dict>
	</array>
	<!-- The UPI apps Cashfree's SDK probes for. iOS refuses canOpenURL for any scheme not
	     listed here, so a missing entry does not error — the app simply never appears in our
	     picker, on a phone that has it installed.

	     This is the exact set the SDK queries, read out of CashfreePGCoreSDK.framework; keep it
	     in step if the pod is upgraded. The loc360 scheme above already covers the return_url. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<!-- One-Tap Call. `tel:` opens regardless, but canLaunchUrl answers false without this. -->
		<string>tel</string>
		<string>phonepe</string>
		<string>tez</string>
		<string>paytmmp</string>
		<string>bhim</string>
		<string>amazonpay</string>
		<string>mobikwik</string>
		<string>credpay</string>
		<string>upi</string>
	</array>
	<!-- Off on purpose: the URL must reach app_links and the splash, which decides whether to
	     show the invite screen. Left on, the platform hands the URL straight to GoRouter and
	     the splash never runs. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
</dict>
</plist>
